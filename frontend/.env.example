# Copia este archivo a .env.local y rellena los valores.
# Los encuentras en el panel de Supabase: Project Settings > API.
#
# Solo las variables que empiezan por VITE_ llegan al navegador.
# La clave anon es publica por diseno y va dentro del bundle: no concede
# ningun permiso por si misma, todo lo deciden las politicas RLS.
# La clave service_role NUNCA debe aparecer en el frontend.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon
