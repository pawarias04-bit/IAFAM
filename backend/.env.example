# Copia este archivo a ".env" y rellena tus valores.
# Datos de ejemplo (NO uses estos secretos en producción).

# Conexión a la base de datos.
#   Vacío/sin definir  → SQLite (backend/data.db, desarrollo)
#   PostgreSQL/Supabase:
#     DATABASE_URL=postgresql://postgres.REFERENCIA:CONTRASENA@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Modo SSL para PostgreSQL (por defecto "require", como pide Supabase)
DATABASE_SSL=require

# Servidor
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# Seguridad: TÚ generas esto (al menos 32 caracteres aleatorios)
SECRET_KEY=dev-super-secret-key-iafam-2026-xxxx
TOKEN_TTL_HOURS=24
MIN_PASSWORD_LENGTH=8

# Admin inicial (se crea solo la primera vez)
ADMIN_EMAIL=admin@iafam.dev
ADMIN_PASSWORD=admin1234